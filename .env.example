# JAY Image Generation Addon — environment.
# Copy to .env and adjust. Author: Alex Stan.

# MQTT broker (local anon on the JAY server)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Model + generation
IMAGE_MODEL=stabilityai/sd-turbo
IMAGE_THREADS=4
IMAGE_STEPS=4
IMAGE_SIZE=512

# HTTP server that serves the generated PNG
IMAGE_HTTP_PORT=8137
# The address PCs will reach to fetch the image (your JAY tailnet IP)
IMAGE_HOST_ADDR=100.119.255.57

# Auto-delete generated PNGs after this many seconds
IMAGE_TTL_SECONDS=600
IMAGE_OUT_DIR=/app/data/out

# Which PC opens the image by default
DEFAULT_PC=laptop
